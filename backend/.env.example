# ==============================================================================
# REAL ESTATE MANAGEMENT API - POSTGRESQL CONFIGURATION
# ==============================================================================
# Application Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Default local PostgreSQL instance:
DATABASE_TYPE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=real_estate
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me

# Remote PostgreSQL on another computer on your Local Network (LAN):
# 1. Replace DATABASE_HOST with the target computer's LAN IP:
#    DATABASE_HOST=192.168.1.100
# 2. Configure postgresql.conf on the remote computer:
#    listen_addresses = '*'
# 3. Configure pg_hba.conf on the remote computer:
#    host    all    all    192.168.1.0/24    scram-sha-256
# 4. Open port 5432 in firewall on the remote computer.

# Optional Direct Connection String Override:
# DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/real_estate

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Normal users/clients interact via REST API and never see database credentials.
# Administrative endpoints (e.g. /admin/db-status) require this admin header:
ADMIN_API_KEY=estateflow_admin_secret_key_2024

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SECRET_KEY=real_estate_super_secret_jwt_key_for_fastapi_production
